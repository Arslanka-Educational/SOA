<?xml version="1.0" encoding="UTF-8"?>
<wsdl:definitions xmlns:wsdl="http://schemas.xmlsoap.org/wsdl/"
                  xmlns:soap="http://schemas.xmlsoap.org/wsdl/soap/"
                  xmlns:tns="http://ifmo.com/se/route-management"
                  xmlns:xsd="http://www.w3.org/2001/XMLSchema"
                  targetNamespace="http://ifmo.com/se/route-management">

    <!-- Типы данных -->
    <wsdl:types>
        <xsd:schema>
            <xsd:import namespace="http://ifmo.com/se/route-management" schemaLocation="schema.xsd"/>
        </xsd:schema>
    </wsdl:types>

    <!-- Сообщения -->
    <wsdl:message name="GetRoutesRequest">
        <wsdl:part name="parameters" element="tns:GetRoutesRequest"/>
    </wsdl:message>
    <wsdl:message name="GetRoutesResponse">
        <wsdl:part name="parameters" element="tns:GetRoutesResponse"/>
    </wsdl:message>

    <!-- Операция -->
    <wsdl:portType name="RouteManagementPort">
        <wsdl:operation name="GetRoutes">
            <wsdl:input message="tns:GetRoutesRequest"/>
            <wsdl:output message="tns:GetRoutesResponse"/>
        </wsdl:operation>
    </wsdl:portType>

    <wsdl:binding name="RouteManagementBinding" type="tns:RouteManagementPort">
        <soap:binding style="document" transport="http://schemas.xmlsoap.org/soap/http"/>
        <wsdl:operation name="GetRoutes">
            <soap:operation soapAction=""/>
            <wsdl:input>
                <soap:body use="literal"/>
            </wsdl:input>
            <wsdl:output>
                <soap:body use="literal"/>
            </wsdl:output>
        </wsdl:operation>
    </wsdl:binding>

    <!-- Сервис -->
    <wsdl:service name="RouteManagementService">
        <wsdl:port name="RouteManagementPort" binding="tns:RouteManagementBinding">
            <soap:address location="http://route-management-service-1:8444/"/>
        </wsdl:port>
    </wsdl:service>
</wsdl:definitions>